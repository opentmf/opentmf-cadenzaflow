<configuration>
  <!-- Human-readable test logging (the main logback config is JSON-structured). -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.opentmf" level="INFO"/>
  <logger name="org.cadenzaflow" level="WARN"/>
  <logger name="org.springframework" level="WARN"/>
  <logger name="org.testcontainers" level="INFO"/>
  <logger name="org.glassfish.jersey.logging.LoggingFeature" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
