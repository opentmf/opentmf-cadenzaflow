<?xml version="1.0" encoding="UTF-8"?>
<!--
  The masked JSON appender, shipped inside the jar so every deployment masks
  identically.

  WHY a whole appender and not just a rule list: Logback's <include> splices only
  top-level elements, so a shared fragment cannot contribute a decorator into an
  appender defined elsewhere. The complete appender lives here; logback-spring.xml
  (and any operator-mounted logback file) does:

      <include resource="logback-masking.xml"/>
      <root level="INFO"><appender-ref ref="JSON"/></root>

  WHY logstash-logback-encoder and not Boot's built-in StructuredLogEncoder with
  format=logstash: the built-in encoder has no masking hook at all. The JSON shape
  is the same; the difference is that this one can redact.

  Two nets, in order (a third - collector-side redaction - sits outside the app):
    1. PATH masks below: any field with one of these names, at any depth, in the
       event, the MDC or a structured argument.
    2. VALUE masks below: regexes applied to every string value, including the
       rendered message text, for data that arrives inside prose.
-->
<included>

  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <!-- `decorator`, not `jsonGeneratorDecorator`: encoder 9.x replaced the
           per-kind setters with a single addDecorator(Decorator). Under the old
           element name Joran logs a warning and silently produces UNMASKED output,
           which is why LogbackMaskingTests asserts on encoded bytes and treats any
           Joran warning as a failure. -->
      <decorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
        <defaultMask>****</defaultMask>

        <!-- Credentials and bearer material. A bare name is a "partial path": it
             matches a field of that name anywhere in the JSON stream. -->
        <path>password</path>
        <path>passwd</path>
        <path>secret</path>
        <path>client_secret</path>
        <path>clientSecret</path>
        <path>credential</path>
        <path>credentials</path>
        <path>authorization</path>
        <path>Authorization</path>
        <path>token</path>
        <path>access_token</path>
        <path>refresh_token</path>
        <path>id_token</path>
        <path>accessToken</path>
        <path>refreshToken</path>
        <path>idToken</path>
        <path>apiKey</path>
        <path>api_key</path>

        <!-- Personal data. `email`/`mail` are field-level only - see the value-mask
             note below for why there is no e-mail regex. -->
        <path>email</path>
        <path>mail</path>
        <path>msisdn</path>
        <path>phoneNumber</path>
        <path>iban</path>
        <path>pin</path>

        <!-- ===== CREDENTIAL-CLASS VALUE MASKS =========================
             The platform floor (dnms combined-rules §13.1), byte-for-byte the
             same regexes as the shared fragment in pia-team/dnms-service-template.
             Credential rules are never allowed to diverge per service: a token is
             a token everywhere, and a service that masks fewer of them is simply
             leaking. Copy changes in both directions verbatim; if a rule here
             stops matching the template's, that is drift, not a decision.

             These matter more here than the path masks suggest. The engine logs
             identity-plugin and REST-client failures verbatim, and a Keycloak
             admin-client error is exactly the place a bearer token echoes into
             free text, where no field-name lookup can reach it.

             Known limit, shared with the template: the key=value rule wants a
             bare separator, so JSON-inside-a-message (`"password":"x"`) is not
             matched by it. Structured occurrences are the path masks' job. -->

        <!-- ===== THE SHARED LEADING GUARD ==============================
             Every value rule below starts with the same three-way lookbehind:

               (?:(?<![A-Za-z0-9])|(?<=%[0-9A-Fa-f]{2})|(?<=%25[0-9A-Fa-f]{2}))

             It replaces a plain `\b`, which cannot fire when the character
             before the value is a word character. Percent-escapes end in word
             characters - `%20` in `0`, `%2B` in `B` - so any value reached
             through a URL-encoded request line sat behind a boundary that never
             existed. 1.2.2 fixed the encoded SEPARATOR inside the auth, JWT and
             grouped-PAN rules but left every rule's leading anchor alone, so an
             encoded `+` still defeated the phone rule AND the 12-digit-run rule
             that is this service's PAN net: `?pan=%2B4111111111111111` was
             logged in clear. 1.2.3 re-anchors all seven.

             What it deliberately does NOT do is relax the identifier case. The
             first alternative still refuses a value glued to a word, so
             `abc491701234567` stays unmasked - that is the behaviour keeping
             process-definition keys and epoch-milli timestamps out of the mask,
             and `leaveDigitRunsInsideIdentifiersAlone` fails if it is widened.
             The guard only adds "or preceded by a COMPLETE percent-escape". -->

        <!-- key=value / key: value secrets inside message text
             ("password=hunter2", "client_secret: abc"). The separator accepts an
             encoded `=` (`%3D`/`%253D`) for the same request-line reason. -->
        <valueMask>
          <value>(?i)(?:(?&lt;![A-Za-z0-9])|(?&lt;=%[0-9A-Fa-f]{2})|(?&lt;=%25[0-9A-Fa-f]{2}))(password|passwd|pwd|secret|token|pin|otp|apikey|api[-_]key|client[-_]secret)\s*(?:[=:]|%(?:25)?3[Dd])\s*"?[^\s",;]+</value>
          <mask>$1=****</mask>
        </valueMask>

        <!-- HTTP auth schemes ("Bearer eyJ…", "Basic dXNlcj…"). Must stay ahead of
             the bare-JWT rule below so the scheme survives for triage.

             The separator alternation is not decoration. A credential that reaches
             the log inside a REQUEST LINE rather than a header is URL-encoded, so
             the space is `%20` (or `%2520` when something double-encodes, or `+` in
             a query string). Requiring a literal \s meant none of those matched, and
             what escaped then depended on the credential: an opaque bearer token or
             a Basic pair was written WHOLE, while a JWT lost only its header segment
             because the bare-JWT rule below happened to catch its payload. Measured,
             not theorised. Keep this rule and the guard below in step.

             This alternation is the platform floor's, byte-for-byte with
             dnms-service-template 1.0.7. -->
        <valueMask>
          <value>(?i)(?:(?&lt;![A-Za-z0-9])|(?&lt;=%[0-9A-Fa-f]{2})|(?&lt;=%25[0-9A-Fa-f]{2}))(bearer|basic)(?:\s|%(?:25)?20|\+)+[A-Za-z0-9._~+/=-]{8,}</value>
          <mask>$1 ****</mask>
        </valueMask>

        <!-- Bare JWTs anywhere (every JWT starts with base64url of '{"' = eyJ).

             The three lookbehinds replace a plain `\b`, which failed whenever the
             preceding character was a word character not part of the token: `%20`
             ends in `0`, so no boundary existed.

             KNOWN DIVERGENCE FROM THE PLATFORM FLOOR, and the one case where the
             "never diverge on a credential rule" note above is knowingly broken.
             dnms-service-template 1.0.7 took the auth alternation above but left
             THIS rule on the original `\b`. Its residue is narrower than ours was,
             because its auth rule already catches `Bearer%20…`; what still slips
             there is a scheme-less token after an encoded separator, `?token=%20eyJ…`.
             Tracked as template 1.0.8, owned by the template; copy the corrected
             rule back and delete this note once it lands.

             A bare `(?&lt;![A-Za-z0-9])` guard was considered and REJECTED - record
             this so it is not proposed again. It excludes `0`, which is the very
             character `%20` ends in, so it fails to fix the encoded-separator case
             it would be written for; `maskABareJwtThatFollowsAnEncodedSeparator`
             fails against it. Hence the explicit alternatives.

             Why this rule still mattered when the header was all that escaped: a
             JWT's PAYLOAD segment also begins with `eyJ` and is preceded by a dot,
             so the old rule matched there and masked payload plus signature,
             leaving only the header. That accident made the defect look harmless on
             JWTs while opaque bearer tokens - no dots, no `eyJ` - leaked whole. Do
             not let it lull a future edit: the guard here is what covers a token
             that has no second `eyJ` to fall back on. -->
        <valueMask>
          <value>(?:(?&lt;![A-Za-z0-9])|(?&lt;=%[0-9A-Fa-f]{2})|(?&lt;=%25[0-9A-Fa-f]{2}))eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9._-]{8,}</value>
          <mask>****</mask>
        </valueMask>

        <!-- Card PANs written in separated groups (4-4-4-2..4). The unseparated
             form is covered by the stricter digit-run rule below.
             The separator class carries the same `%20` alternation as the auth rule,
             for the same reason: a PAN arriving in a request line is encoded, and
             neither this rule nor the digit-run rule could see it otherwise. -->
        <valueMask>
          <value>(?:(?&lt;![A-Za-z0-9])|(?&lt;=%[0-9A-Fa-f]{2})|(?&lt;=%25[0-9A-Fa-f]{2}))\d{4}(?:[ -]|%(?:25)?20)\d{4}(?:[ -]|%(?:25)?20)\d{4}(?:[ -]|%(?:25)?20)\d{2,4}\b</value>
          <mask>****</mask>
        </valueMask>

        <!-- ===== PII-CLASS VALUE MASKS ================================
             Unlike the credential floor, these are this service's own and
             DIVERGE from the template on purpose. Each divergence is pinned by a
             case in LogbackMaskingTests, so a later "align with the template"
             edit fails a test instead of silently changing what the engine logs.
             Two of the three are STRICTER than the template, which is always
             acceptable; the third is looser and is argued below. -->

        <!-- IBAN anywhere in a string value, including inside a message.
             DIVERGENCE (stricter): the template keeps country + check digits
             ("DE44****") for payment triage. This service never reconciles
             payments, so the whole value goes. -->
        <value>(?:(?&lt;![A-Za-z0-9])|(?&lt;=%[0-9A-Fa-f]{2})|(?&lt;=%25[0-9A-Fa-f]{2}))[A-Z]{2}\d{2}[A-Z0-9]{11,30}\b</value>

        <!-- German phone numbers in the +49… / 0049… / 0… shapes, with the `+`
             also accepted encoded (`%2B`, `%252B`, either case) - the platform
             fragment's alternation.

             THE ONE RULE THAT KEEPS `\b` IN ITS GUARD, and it is not decoration.
             This rule's alternation can begin with `+`, a NON-word character, and
             `\b` before a non-word character fires when the preceding character IS
             a word character - the inverse of every other rule here. Dropping it
             for the uniform guard NARROWED the rule: `x+491701234` masked before
             and stopped masking, because a 9-digit number is below the 12-digit-run
             rule's floor and nothing else caught it. So the guard is the UNION of
             the rule's own boundary and the shared one, which is strictly wider
             than either. Measured against the 1.2.2 file across every rule x
             prefix: 0 narrowings, many widenings. A subject's MSISDN arrives in process-variable
             dumps in clear, so the e-mail attribution argument below does NOT
             cover this: there is no actor to preserve in a customer's number.

             DECLINED, with reason: template 1.0.8 also carries a `+`-stripped
             MSISDN rule anchored on DE 491[5-7] / TR 905, with a stated
             false-positive rate. It buys nothing here - the 12-digit-run rule
             below already masks a bare `491…`/`905…` number, and now does so
             behind an encoded prefix too - so taking it would import known false
             positives for coverage this service already has. Revisit only if the
             digit-run rule is ever loosened. -->
        <value>(?:\b|(?&lt;![A-Za-z0-9])|(?&lt;=%[0-9A-Fa-f]{2})|(?&lt;=%25[0-9A-Fa-f]{2}))(?:(?:\+|%(?:25)?2[Bb]|00)49|0)[1-9]\d{6,13}\b</value>

        <!-- Runs of 12+ digits (card numbers, long account refs).
             DIVERGENCE (stricter): the template deliberately leaves the
             unseparated form alone because ids and epoch timestamps look the
             same. Here the engine renders process-variable dumps into message
             text, so an unseparated PAN really can arrive in prose and the
             false positives - epoch-milli timestamps, mostly - are worth it.
             Deliberately not shorter than 12: process-definition keys, job
             retries and incident counts are numeric too, and masking those
             would gut the operational logs. -->
        <value>(?:(?&lt;![A-Za-z0-9])|(?&lt;=%[0-9A-Fa-f]{2})|(?&lt;=%25[0-9A-Fa-f]{2}))\d{12,}\b</value>

        <!-- DELIBERATELY ABSENT: an e-mail value regex.
             DIVERGENCE (looser): the template masks the local part and keeps the
             domain. Here the CadenzaFlow user id IS the e-mail address
             (use-email-as-camunda-user-id, for both the Keycloak and the Entra
             identity provider), so a value-level e-mail mask would redact the
             ACTOR from every authorization, task-claim and incident line - it
             would destroy the audit trail it is meant to protect. Structured
             occurrences are still covered by the `email`/`mail` path masks above.

             RESIDUAL RISK, accepted and documented rather than fixed: external
             task workers submit errorMessage text that the engine logs verbatim,
             so a CUSTOMER e-mail carried in such a message stays readable too. No
             regex can tell an actor's address from a subject's - they are the same
             token in the same position. This is bounded by the other two nets:
             net #1, workers must not put raw PII in error messages, and net #3,
             collector-side redaction. Do not "fix" this by adding the e-mail
             regex; that trades a bounded risk for an unbounded loss of
             attribution. -->
      </decorator>
    </encoder>
  </appender>

</included>
