# Stage 1: Build the JAR using Maven (bytecode target 25 via maven.compiler.*)
FROM maven:3.9.12-eclipse-temurin-25 AS maven-build
WORKDIR /build
ARG MAVEN_PROFILES=repackage
COPY pom.xml .
COPY src ./src
RUN mvn -Dmaven.test.skip=true -Dmaven.javadoc.skip=true -Dmaven.source.skip=true -P ${MAVEN_PROFILES} clean package

# Stage 2: Extract layers
FROM eclipse-temurin:25-jre-noble AS layer-extract
WORKDIR /application
COPY --from=maven-build /build/target/*.jar application.jar
# Spring Boot 4 removed the layertools jarmode; the tools jarmode with
# --layers --launcher produces the same layered, JarLauncher-ready layout.
RUN java -Djarmode=tools -jar application.jar extract --layers --launcher --destination extracted

# Stage 3: Final runtime image
# JRE 25 matches the GraalJS/Truffle 25.x runtime requirement. JS script tasks still run
# interpreted: as of GraalVM 25, in-process JIT of guest code requires a GraalVM JDK.
FROM eclipse-temurin:25-jre-noble
RUN apt-get update && \
    apt-get install -y curl iputils-ping procps rsync && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup java && \
    adduser --ingroup java --disabled-password java
USER java
WORKDIR /application
COPY --chown=java:java --from=layer-extract /application/extracted/dependencies/ ./
COPY --chown=java:java --from=layer-extract /application/extracted/spring-boot-loader/ ./
COPY --chown=java:java --from=layer-extract /application/extracted/snapshot-dependencies/ ./
COPY --chown=java:java --from=layer-extract /application/extracted/application/ ./

# set minimal JVM options
ENV SERVER_PORT=8080
EXPOSE ${SERVER_PORT}
ENV JVM_OPTS="-Duser.timezone=UTC -Dserver.port=${SERVER_PORT}"

ENTRYPOINT ["sh","-lc","exec java ${JVM_OPTS} org.springframework.boot.loader.launch.JarLauncher"]
CMD []
