  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>25</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>

    <spring-boot.repackage.skip>true</spring-boot.repackage.skip>

    <!-- Application dependencies -->
    <!-- Spring Boot 4 - aligned with the version the CadenzaFlow spring-boot-starter-4 is built against -->
    <spring-boot.version>4.0.7</spring-boot.version>
    <!--
      CadenzaFlow 1.2.0+ (including the Spring Boot 4 starters) is not yet on Maven
      Central (Central has only up to 1.1.0), but is published on the CadenzaFlow
      Nexus - see the <repositories> section below.
    -->
    <cadenzaflow.version>1.2.0</cadenzaflow.version>
    <!--
      The cadenzaflow-keycloak 1.0.1 release on the CadenzaFlow Nexus is compiled
      against spring-web 6 and crashes on Spring Framework 7 at engine bootstrap
      (IncompatibleClassChangeError: HttpHeaders no longer implements MultiValueMap).
      Until a spring-web-7-compiled artifact is released, build it locally from
      https://github.com/cadenzaflow/cadenzaflow-keycloak with:
        mvn -pl extension clean install -DskipTests -Dversion.spring-web6=7.0.6
      (source of 1.0.1 needs no code changes; the 1.0.1-SNAPSHOT master additionally
      needs getStatusCodeValue() -> getStatusCode().value()).
    -->
    <cadenzaflow-keycloak.version>1.0.1-SNAPSHOT</cadenzaflow-keycloak.version>
    <cadenzaflow-incident-logger.version>1.0.0-SNAPSHOT</cadenzaflow-incident-logger.version>
    <openid-rbac-security.version>2.1.0</openid-rbac-security.version>
    <graalvm.version>25.1.3</graalvm.version>

    <archunit.version>1.4.2</archunit.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <testcontainers-keycloak.version>4.2.1</testcontainers-keycloak.version>

    <!-- Maven plugins -->
    <sonar-plugin.version>5.7.0.6970</sonar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>

    <!-- Sonar properties -->
    <sonar.coverage.exclusions>**/OpenTmfCadenzaFlowApplication.java</sonar.coverage.exclusions>

    <!-- AWS-IAM related properties -->
    <aws-msk-iam-auth.version>2.3.5</aws-msk-iam-auth.version>
    <awssdk-sts.version>2.42.8</awssdk-sts.version>
    <aws-advanced-jdbc-wrapper.version>3.2.0</aws-advanced-jdbc-wrapper.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
