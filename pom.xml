<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.opentmf.cadenzaflow</groupId>
  <artifactId>opentmf-cadenzaflow</artifactId>
  <name>opentmf-cadenzaflow</name>
  <version>1.2.0</version>

  <description>
    An OpenTMF produced Spring Boot 4 microservice that embeds the CadenzaFlow community edition
    (the maintained Camunda 7 fork) with the public Spin, and OpenID auth for Keycloak plugins,
    as well as OpenTMF's "openid-rbac-security" library.
  </description>

  <url>https://github.com/opentmf/opentmf-cadenzaflow</url>

  <organization>
    <name>PiA Group</name>
    <url>https://www.pia-group.net/</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>A permissive open-source license</comments>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>cezmi-aslan</id>
      <name>Cezmi Aslan</name>
      <email>cezmiaslan@gmail.com</email>
    </developer>
  </developers>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>25</java.version>
    <!-- `release` supersedes source+target: it also pins the API signatures the
         compiler resolves against, so a Java 25 build cannot accidentally link
         a symbol that a Java 25 runtime lacks. -->
    <maven.compiler.release>${java.version}</maven.compiler.release>

    <spring-boot.repackage.skip>true</spring-boot.repackage.skip>

    <!-- Keeps `mvn versions:display-*-updates` stable-only. The separator after the
         qualifier is optional and may be `-` or `.`: without that, `4.0.0-beta-4`
         and `4.0.0-beta.38` slipped through and were offered as upgrades, which is
         exactly what this property exists to prevent. -->
    <maven.version.ignore>.*-M\d+,.*-RC\d+,.*-SNAPSHOT,(?i).*-(alpha|beta|rc|cr|pre)[-.]?\d*</maven.version.ignore>

    <!-- Application dependencies -->
    <!-- Spring Boot 4. Ahead of the CadenzaFlow SB4 starters' own baseline (their
         parent pins 4.0.7); the compatibility proof is this repo's full IT suite,
         which boots the engine, both identity plugins and the REST surface. -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <cadenzaflow.version>1.2.3</cadenzaflow.version>
    <!-- The -4 artifact is the spring-web-7-compiled line matching the SB4 starters -->
    <cadenzaflow-keycloak.version>1.1.2</cadenzaflow-keycloak.version>
    <cadenzaflow-entra-identity.version>1.2.0</cadenzaflow-entra-identity.version>
    <!-- 3.0.0: denied requests on an MVC-served path answer 405 for an unserved
         method (opentmf.security.unmatched-method-response). Inert here - this
         service serves no Spring MVC endpoints of its own; Jersey-served paths are
         invisible to the resolver and keep answering 401/403 exactly as before. -->
    <openid-rbac-security.version>3.0.0</openid-rbac-security.version>
    <graalvm.version>25.3.4.1</graalvm.version>
    <!-- Not BOM-managed. 9.x is the Logback 1.5 / Boot 4 line. -->
    <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>

    <!-- The postgresql/netty/httpcore5 CVE overrides that lived here until 1.2.0
         are gone: the Spring Boot 4.1.1 BOM manages 42.7.13 / 4.2.17.Final / 5.4.3
         itself - exactly the fixed versions the overrides pinned. -->

    <!-- TMF-630 paging/sorting semantics for the incident list. The -core module
         only: its logic (status resolution, range/link headers, sort grammar with
         allowlist) is plain public API, called programmatically from the Jersey
         resource - the -autoconfigure sibling is Spring-MVC-only and would never
         see a request under /engine-rest. -->
    <tmf630-toolkit.version>3.1.1</tmf630-toolkit.version>

    <archunit.version>1.5.0</archunit.version>
    <wiremock.version>3.13.2</wiremock.version>
    <pitest-maven.version>1.25.9</pitest-maven.version>
    <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <testcontainers-keycloak.version>4.3.1</testcontainers-keycloak.version>

    <!-- Maven plugins -->
    <sonar-plugin.version>5.7.0.6970</sonar-plugin.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>

    <!-- Sonar properties. Organization + project key target SonarCloud and are used
         by the GitHub Actions workflows; the local `sonar` profile below overrides
         the project key and host URL for scans against a local SonarQube. -->
    <sonar.organization>opentmf</sonar.organization>
    <sonar.projectKey>opentmf_opentmf-cadenzaflow</sonar.projectKey>
    <sonar.coverage.exclusions>**/OpenTmfCadenzaFlowApplication.java</sonar.coverage.exclusions>
    <!-- java:S2143 (use java.time) is exempted for the extensions tree, where
         java.util.Date IS the API's date vocabulary on purpose: the engine's query
         API takes Date and the engine REST Jackson setup formats Date - java.time
         would mean converters at every engine boundary. The rule is file-level, so
         this cannot be an in-code @SuppressWarnings. -->
    <sonar.issue.ignore.multicriteria>engineDates</sonar.issue.ignore.multicriteria>
    <sonar.issue.ignore.multicriteria.engineDates.ruleKey>java:S2143</sonar.issue.ignore.multicriteria.engineDates.ruleKey>
    <sonar.issue.ignore.multicriteria.engineDates.resourceKey>**/extensions/**</sonar.issue.ignore.multicriteria.engineDates.resourceKey>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
    </dependency>

    <!-- CadenzaFlow Dependencies (Spring Boot 4 starters) -->
    <dependency>
      <groupId>org.cadenzaflow.bpm.springboot</groupId>
      <artifactId>cadenzaflow-bpm-spring-boot-starter-rest-4</artifactId>
      <version>${cadenzaflow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cadenzaflow.bpm.springboot</groupId>
      <artifactId>cadenzaflow-bpm-spring-boot-starter-webapp-4</artifactId>
      <version>${cadenzaflow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cadenzaflow.spin</groupId>
      <artifactId>cadenzaflow-spin-dataformat-json-jackson</artifactId>
      <version>${cadenzaflow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cadenzaflow.bpm</groupId>
      <artifactId>cadenzaflow-engine-plugin-spin</artifactId>
      <version>${cadenzaflow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cadenzaflow.bpm.extension</groupId>
      <artifactId>cadenzaflow-keycloak-4</artifactId>
      <version>${cadenzaflow-keycloak.version}</version>
    </dependency>
    <!-- Entra ID (Azure AD) identity provider alternative; selected via plugin.identity.provider.
         The -4 artifact is the spring-web-7-compiled line, matching cadenzaflow-keycloak-4. -->
    <dependency>
      <groupId>org.cadenzaflow.bpm.extension</groupId>
      <artifactId>cadenzaflow-entra-identity-4</artifactId>
      <version>${cadenzaflow-entra-identity.version}</version>
    </dependency>
    <dependency>
      <groupId>org.graalvm.js</groupId>
      <artifactId>js-scriptengine</artifactId>
      <version>${graalvm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.graalvm.js</groupId>
      <artifactId>js</artifactId>
      <version>${graalvm.version}</version>
      <type>pom</type>
      <scope>runtime</scope>
    </dependency>
    <!-- OpenTMF OpenID Security (2.x line = Spring Boot 4) -->
    <dependency>
      <groupId>org.opentmf.security</groupId>
      <artifactId>openid-rbac-security</artifactId>
      <version>${openid-rbac-security.version}</version>
    </dependency>

    <!-- Bean Validation for the incident-operations request bodies and the
         @Validated properties class; nothing else on the classpath ships an
         implementation. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- TMF-630 paging/sorting core (see the version property for why not the
         -autoconfigure module). spring-data-commons is its Page/Pageable/Sort
         vocabulary - JPA-free; version from the Spring Boot BOM. -->
    <dependency>
      <groupId>org.opentmf.query</groupId>
      <artifactId>tmf630-toolkit-paging-sorting-core</artifactId>
      <version>${tmf630-toolkit.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-commons</artifactId>
    </dependency>

    <!-- Database dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Monitoring dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Logging dependencies -->
    <dependency>
      <groupId>org.codehaus.janino</groupId>
      <artifactId>janino</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- JSON log encoder with a masking hook (logback-masking.xml). Boot's built-in
         StructuredLogEncoder produces the same shape but cannot redact, which is why
         it is not used here. Runtime scope: wired from logback XML, never imported. -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>${logstash-logback-encoder.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- standalone (shaded) build: bundles its own Jetty, avoiding servlet-stack clashes -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.dasniko</groupId>
      <artifactId>testcontainers-keycloak</artifactId>
      <version>${testcontainers-keycloak.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Optional dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <!--
      banner.txt is Maven-filtered at build time with '@' delimiters only (see the
      maven-resources-plugin configuration below): @...@ tokens resolve during the build
      (e.g. @project.version@), while ${...} tokens survive the build and are resolved by
      Spring's banner rendering at runtime (e.g. ${java.runtime.version}). Other resources
      are NOT filtered to avoid breaking binary content. spring-boot-starter-parent wires
      all this implicitly; we use BOM-only, so it is declared here explicitly.
    -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>banner.txt</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>banner.txt</exclude>
        </excludes>
      </resource>
    </resources>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Annotation processing must be requested EXPLICITLY. Java 23 disabled implicit
        processing, so without <proc>full</proc> javac silently ignores every processor
        on the classpath - here spring-boot-configuration-processor, whose output
        (META-INF/spring-configuration-metadata.json) is what gives an IDE completion and
        documentation for `plugin.identity.entra.*`, `plugin.identity.keycloak.*` and
        `sso.*`. Silently, because a skipped processor is not an error: the build stays
        green and the metadata simply never appears.

        NOT set: <parameters>. Parameter names stay erased, which is what the explicit-name
        rule on request-binding annotations (ArchitectureTests) assumes.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <proc>full</proc>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>${maven-resources-plugin.version}</version>
        <configuration>
          <!-- '@' only, so ${...} placeholders in banner.txt survive for Spring's
               runtime banner resolution instead of being consumed by Maven filtering -->
          <delimiters>
            <delimiter>@</delimiter>
          </delimiters>
          <useDefaultDelimiters>false</useDefaultDelimiters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-maven</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>25</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>3.9.0</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <skip>${spring-boot.repackage.skip}</skip>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
          <!-- Bound the wait on a fork that will not exit, so a hung test reports
               as a failure instead of stalling the pipeline indefinitely. -->
          <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven-failsafe-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
          <!-- Each IT boots its own engine; the engine registers a JVM-global MBean
               (process-engine:type=default), so cached contexts from a shared fork
               collide. One fresh JVM per IT class keeps them isolated. -->
          <forkCount>1</forkCount>
          <reuseForks>false</reuseForks>
          <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
          <!-- When repackaging is on (repackage/docker profiles), the main artifact is the
               fat jar and its classes sit under BOOT-INF/classes, which breaks the
               @SpringBootConfiguration upward search. Point failsafe at the classes dir. -->
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
        <version>${maven-release-plugin.version}</version>
        <configuration>
          <releaseProfiles>release</releaseProfiles>
          <goals>deploy</goals>
          <tagNameFormat>@{project.version}</tagNameFormat>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <configuration>
          <!-- The entry class is a Boot bootstrap with a one-line main; it has no
               branch to assert and would otherwise hold the missed-CLASS count
               above zero forever. Mirrors sonar.coverage.exclusions. -->
          <excludes>
            <exclude>**/OpenTmfCadenzaFlowApplication.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <!-- A gate, not a report: a coverage regression fails `mvn verify`
                   rather than printing a warning nobody reads. The thresholds are
                   80% (not the DNMS estate's 90%) - see the coverage deviation in
                   docs/component-design-card.md. -->
              <haltOnFailure>true</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <minimum>80%</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <minimum>80%</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <minimum>80%</minimum>
                      <value>COVEREDRATIO</value>
                    </limit>
                    <limit>
                      <counter>CLASS</counter>
                      <maximum>0</maximum>
                      <value>MISSEDCOUNT</value>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Profile to create a local Docker image -->
  <profiles>
    <!-- PIT mutation testing ON DEMAND: an instrument, not a gate. Unit tests only
         (surefire *Test - never failsafe/Testcontainers).
         `mvn -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage` -->
    <profile>
      <id>mutation</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-maven</artifactId>
              <version>${pitest-maven.version}</version>
              <dependencies>
                <dependency>
                  <groupId>org.pitest</groupId>
                  <artifactId>pitest-junit5-plugin</artifactId>
                  <version>${pitest-junit5-plugin.version}</version>
                </dependency>
              </dependencies>
              <configuration>
                <!-- Stated rather than inherited: with targetClasses absent PIT
                     falls back to the project groupId, so a groupId change would
                     silently move what gets mutated. -->
                <targetClasses>
                  <param>org.opentmf.cadenzaflow.*</param>
                </targetClasses>
                <targetTests>
                  <param>org.opentmf.cadenzaflow.*</param>
                </targetTests>
                <excludedTestClasses>
                  <param>*IT</param>
                </excludedTestClasses>
                <mutators>
                  <mutator>DEFAULTS</mutator>
                </mutators>
                <!-- No withHistory: since 1.20 incremental analysis lives in a
                     separate history plugin (the open-source build fails outright
                     with "History has been enabled but no history plugin has been
                     installed", pointing at arcmutate's commercial
                     +arcmutate_history). Losing it costs nothing here - a full run
                     is a couple of minutes - and it removes a trap: the history is
                     keyed on mutated-class hashes only, so STRENGTHENING a test did
                     not invalidate the entry and the survivor kept reporting as
                     SURVIVED until the history file was deleted by hand. -->
                <!-- No mutationThreshold - survivor review is the unit of work. -->
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <failOnWarnings>false</failOnWarnings>
                  <failOnError>false</failOnError>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>publish-to-central</publishingServerId>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>aws</id>
      <properties>
        <aws-msk-iam-auth.version>2.3.7</aws-msk-iam-auth.version>
        <awssdk.version>2.54.10</awssdk.version>
        <aws-advanced-jdbc-wrapper.version>4.4.0</aws-advanced-jdbc-wrapper.version>
      </properties>
      <dependencyManagement>
        <dependencies>
          <!-- The AWS SDK v2 BOM aligns EVERY software.amazon.awssdk module on one
               version. It is not optional housekeeping here: aws-msk-iam-auth pulls
               `auth` at its own SDK version from the same depth as sts's transitives,
               and Maven's nearest-wins then resolves by declaration order, which used
               to ship `auth` 2.44.12 against sdk-core/aws-core 2.52.0. `auth` is the
               module implementing the IRSA/WebIdentity credential providers that sts
               is here for, and AWS does not support mixing module versions - the
               failure mode is NoSuchMethodError at credential-resolution time, in a
               code path no test covers. Bumping sts alone would only widen the gap. -->
          <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>bom</artifactId>
            <version>${awssdk.version}</version>
            <type>pom</type>
            <scope>import</scope>
          </dependency>
        </dependencies>
      </dependencyManagement>
      <dependencies>
        <dependency>
          <groupId>software.amazon.msk</groupId>
          <artifactId>aws-msk-iam-auth</artifactId>
          <version>${aws-msk-iam-auth.version}</version>
          <scope>runtime</scope>
        </dependency>
        <!-- AWS JDBC wrapper driver -->
        <dependency>
          <groupId>software.amazon.jdbc</groupId>
          <artifactId>aws-advanced-jdbc-wrapper</artifactId>
          <version>${aws-advanced-jdbc-wrapper.version}</version>
          <scope>runtime</scope>
        </dependency>
        <!-- Required for IRSA / WebIdentity credentials on Java. Version comes from
             the SDK BOM above - do not pin it here. -->
        <dependency>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>sts</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <!-- Azure twin of the aws profile: passwordless datasource auth for Azure Database for
         PostgreSQL via Entra ID tokens. azure-identity-extensions plugs into the
         standard PostgreSQL driver (authenticationPluginClassName) and its transitive
         azure-identity resolves credentials via DefaultAzureCredential (AKS Workload
         Identity, managed identity, env vars). See README - Cloud deployment variants. -->
    <profile>
      <id>azure</id>
      <!-- Azure passwordless datasource auth. The version lives HERE, not in the
           top-level <properties>, so that every flavour's dependency versions sit
           with the flavour that uses them - the same shape as the aws profile above.
           Consequence for upgrade checks: a property inside an inactive profile is
           not in the effective model and the versions plugin cannot see it, so the
           check must activate every flavour:
             mvn versions:display-property-updates -Paws,azure \
                 -Dmaven.version.ignore="(?i).*-(alpha|beta|m|rc).*"
           An unprofiled run reports BUILD SUCCESS with no findings, which reads
           exactly like "everything is current". -->
      <properties>
        <azure-identity-extensions.version>1.2.9</azure-identity-extensions.version>
      </properties>
      <dependencies>
        <dependency>
          <groupId>com.azure</groupId>
          <artifactId>azure-identity-extensions</artifactId>
          <version>${azure-identity-extensions.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>repackage</id>
      <properties>
        <spring-boot.repackage.skip>false</spring-boot.repackage.skip>
      </properties>
    </profile>
    <profile>
      <id>docker</id>
      <properties>
        <spring-boot.repackage.skip>false</spring-boot.repackage.skip>
        <trivy-image.version>0.72.0</trivy-image.version>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <executions>
              <!-- Remove existing docker image from local repo -->
              <execution>
                <id>docker-clean</id>
                <phase>clean</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>docker</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <arguments>
                    <argument>image</argument>
                    <argument>rm</argument>
                    <argument>--force</argument>
                    <argument>local/${project.artifactId}:${project.version}</argument>
                  </arguments>
                </configuration>
              </execution>

              <!-- Create new docker image -->
              <execution>
                <id>docker-build</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>docker</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <arguments>
                    <argument>build</argument>
                    <argument>-t</argument>
                    <argument>local/${project.artifactId}:${project.version}</argument>
                    <argument>.</argument>
                  </arguments>
                </configuration>
              </execution>

              <!-- Trivy scan of the freshly built image; runs via the official Trivy
                   container (no local install needed) with the Docker socket mounted.
                   Any HIGH or CRITICAL finding exits non-zero and fails the build.
                   The named volume caches the vulnerability DB between runs. -->
              <execution>
                <id>trivy-scan</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>docker</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <arguments>
                    <argument>run</argument>
                    <argument>--rm</argument>
                    <argument>-v</argument>
                    <argument>/var/run/docker.sock:/var/run/docker.sock</argument>
                    <argument>-v</argument>
                    <argument>trivy-cache:/root/.cache/trivy</argument>
                    <argument>-v</argument>
                    <argument>${project.basedir}/.trivyignore:/.trivyignore:ro</argument>
                    <argument>aquasec/trivy:${trivy-image.version}</argument>
                    <argument>image</argument>
                    <!-- default 5m is eaten by the first-run DB downloads -->
                    <argument>--timeout</argument>
                    <argument>15m</argument>
                    <argument>--ignorefile</argument>
                    <argument>/.trivyignore</argument>
                    <argument>--exit-code</argument>
                    <argument>1</argument>
                    <argument>--severity</argument>
                    <argument>HIGH,CRITICAL</argument>
                    <argument>local/${project.artifactId}:${project.version}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Local SonarQube scan profile. Talks to a developer-managed local SonarQube
      (not SonarCloud). Project history accumulates across scans; profile stays
      small and does not own the SonarQube lifecycle.

      Developer prerequisites (one-time setup):
        1. Run a SonarQube Community container reachable at http://localhost:9000
           (image: sonarqube:community).
        2. In the SonarQube UI, create a project with key
           org.opentmf.cadenzaflow:opentmf-cadenzaflow and generate an analysis token.
        3. Export the token as SONAR_TOKEN - the scanner reads it natively.

      Then on each scan:
        mvn -P sonar clean verify

      Build fails on quality-gate != OK. Do NOT combine with the `docker` profile
      (which skips tests) - Sonar needs the test run + JaCoCo coverage.
    -->
    <profile>
      <id>sonar</id>
      <properties>
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.projectKey>org.opentmf.cadenzaflow:opentmf-cadenzaflow</sonar.projectKey>
        <sonar.qualitygate.wait>true</sonar.qualitygate.wait>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonarsource.scanner.maven</groupId>
            <artifactId>sonar-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>sonar-scan</id>
                <phase>verify</phase>
                <goals>
                  <goal>sonar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <scm>
    <url>https://github.com/opentmf/opentmf-cadenzaflow</url>
    <connection>scm:git:git@github.com:opentmf/opentmf-cadenzaflow.git</connection>
    <developerConnection>scm:git:git@github.com:opentmf/opentmf-cadenzaflow.git</developerConnection>
    <tag>1.2.0</tag>
  </scm>

</project>
