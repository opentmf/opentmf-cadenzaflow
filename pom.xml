    </dependency>
    <dependency>
      <groupId>org.cadenzaflow.bpm</groupId>
      <artifactId>cadenzaflow-engine-plugin-spin</artifactId>
      <version>${cadenzaflow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cadenzaflow.bpm.extension</groupId>
      <artifactId>cadenzaflow-keycloak</artifactId>
      <version>${cadenzaflow-keycloak.version}</version>
    </dependency>
