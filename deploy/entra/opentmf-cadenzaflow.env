# opentmf-cadenzaflow — environment for an ENTRA-ID-ONLY deployment.
#
# Fill in every <PLACEHOLDER>. Everything else is already correct for this shape of
# deployment; each block says what it does and why it is set that way.
# Setup instructions: README.md in this directory.
#
# NEVER commit this file once the secret is filled in.

# =============================================================================
# 1. Fill these in
# =============================================================================
# Directory (tenant) ID and Application (client) ID from the app registration
# Overview page; the secret is the Value column of the client secret, not its ID.
ENTRA_TENANT_ID=<TENANT_ID>
ENTRA_CLIENT_ID=<CLIENT_ID>
ENTRA_CLIENT_SECRET=<CLIENT_SECRET_VALUE>

# The hostname a BROWSER reaches this service on (Ingress / load balancer), with
# scheme and no trailing slash — e.g. https://workflow.example.com
EXTERNAL_BASE_URL=<https://EXTERNAL_HOST>

# =============================================================================
# 2. Database
# =============================================================================
# The engine creates and patches its own ACT_* tables at start-up. Give it a schema
# of its own; the schema must already exist.
SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>?useUnicode=yes&characterEncoding=UTF-8&currentSchema=cadenzaflow
SPRING_DATASOURCE_USERNAME=<DB_USER>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>
SPRING_DATASOURCE_HIKARI_SCHEMA=cadenzaflow

# =============================================================================
# 3. Identity provider — the directory of users and groups
# =============================================================================
# The engine mounts exactly one identity provider. `entra` reads users and group
# membership from Microsoft Graph on demand: no background synchronisation, no
# local user table, and nothing to reconcile.
PLUGIN_IDENTITY_PROVIDER=entra

PLUGIN_IDENTITY_ENTRA_TENANT_ID=${ENTRA_TENANT_ID}
PLUGIN_IDENTITY_ENTRA_CLIENT_ID=${ENTRA_CLIENT_ID}
PLUGIN_IDENTITY_ENTRA_CLIENT_SECRET=${ENTRA_CLIENT_SECRET}

# The engine user id is the mail address, which is also what the token's `email`
# claim carries — so the authenticated principal and the directory user are the
# same string, and task assignment survives a sign-out.
PLUGIN_IDENTITY_ENTRA_USE_EMAIL_AS_CAMUNDA_USER_ID=true
# Accounts without a mailbox (guests, some service accounts) fall back to their UPN
# instead of failing to resolve.
PLUGIN_IDENTITY_ENTRA_FALLBACK_TO_UPN_WHEN_MAIL_EMPTY=true
# Group ids are the readable display name rather than an opaque object id, so
# authorisations configured in the engine stay legible.
PLUGIN_IDENTITY_ENTRA_USE_GROUP_DISPLAY_NAME_AS_CAMUNDA_GROUP_ID=true
# Nested groups count: a member of a group that is itself a member of camunda-admin
# is an administrator.
PLUGIN_IDENTITY_ENTRA_TRANSITIVE_GROUP_MEMBERSHIP=true
# Ignore distribution and Microsoft 365 groups — only security groups grant anything.
PLUGIN_IDENTITY_ENTRA_SECURITY_GROUPS_ONLY=true
# Members of this security group get workflow-engine administrator rights. This is
# GROUP MEMBERSHIP read from Graph, not an app-role assignment.
PLUGIN_IDENTITY_ENTRA_ADMINISTRATOR_GROUP_NAME=camunda-admin
PLUGIN_IDENTITY_ENTRA_CACHE_ENABLED=true

# =============================================================================
# 4. Token validation — who may call the REST API
# =============================================================================
# Declared as an ISSUER LIST even though there is only one issuer. This is
# deliberate: the single-issuer form validates neither `iss` nor `aud`, and one
# Entra tenant mints tokens for many applications — so issuer-only trust would
# accept a token minted for a different application of the same tenant. The list
# form checks both.
#
# REQUIRED, and it must stay empty. The image ships a single-issuer
# `opentmf.security.jwk-set-uri` default (the Keycloak shape). Declaring the
# issuer list while that default is still in place means trust is declared
# twice, which fails the boot by design:
#
#   Property: opentmf.security.trustDeclaredExactlyOnce
#   Reason: Declare exactly one of 'jwk-set-uri' or 'issuers'
#
# Clearing it here is what lets the list below take effect.
OPENTMF_SECURITY_JWK_SET_URI=

OPENTMF_SECURITY_ISSUERS_0_NAME=entra
OPENTMF_SECURITY_ISSUERS_0_ISSUER=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/v2.0
OPENTMF_SECURITY_ISSUERS_0_JWK_SET_URI=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/discovery/v2.0/keys
# The caller's identity, with a fallback for principals that carry no mail address.
OPENTMF_SECURITY_ISSUERS_0_USER_CLAIM=email
OPENTMF_SECURITY_ISSUERS_0_FALLBACK_USER_CLAIMS_0=preferred_username
# Entra delivers app roles in `roles`. (Keycloak-style deployments use `groups`.)
OPENTMF_SECURITY_ISSUERS_0_AUTHORITIES_CLAIM=roles
# The expected audience. Bare client id because the app registration sets
# requestedAccessTokenVersion: 2; a version-1 token carries api://<client-id>
# instead — and a different issuer with it.
OPENTMF_SECURITY_ISSUERS_0_AUDIENCES_0=${ENTRA_CLIENT_ID}

# =============================================================================
# 5. Endpoint authorisation
# =============================================================================
# Maps the engine REST API onto the app roles created in the app registration. A
# caller needs ANY ONE of the roles listed for the method it is using.
OPENTMF_SECURITY_SECURE_ENDPOINTS_0_METHOD=GET
OPENTMF_SECURITY_SECURE_ENDPOINTS_0_PATH=/engine-rest/**
OPENTMF_SECURITY_SECURE_ENDPOINTS_0_ROLES_0=reader
OPENTMF_SECURITY_SECURE_ENDPOINTS_0_ROLES_1=writer
OPENTMF_SECURITY_SECURE_ENDPOINTS_0_ROLES_2=admin

OPENTMF_SECURITY_SECURE_ENDPOINTS_1_METHOD=POST
OPENTMF_SECURITY_SECURE_ENDPOINTS_1_PATH=/engine-rest/**
OPENTMF_SECURITY_SECURE_ENDPOINTS_1_ROLES_0=writer
OPENTMF_SECURITY_SECURE_ENDPOINTS_1_ROLES_1=admin

OPENTMF_SECURITY_SECURE_ENDPOINTS_2_METHOD=PUT
OPENTMF_SECURITY_SECURE_ENDPOINTS_2_PATH=/engine-rest/**
OPENTMF_SECURITY_SECURE_ENDPOINTS_2_ROLES_0=writer
OPENTMF_SECURITY_SECURE_ENDPOINTS_2_ROLES_1=admin

OPENTMF_SECURITY_SECURE_ENDPOINTS_3_METHOD=DELETE
OPENTMF_SECURITY_SECURE_ENDPOINTS_3_PATH=/engine-rest/**
OPENTMF_SECURITY_SECURE_ENDPOINTS_3_ROLES_0=writer
OPENTMF_SECURITY_SECURE_ENDPOINTS_3_ROLES_1=admin

# NOTE ON EXTERNAL-TASK WORKERS. /engine-rest/external-task/** is whitelisted by
# default so high-frequency worker polling costs no token round-trips. That is only
# safe where the application port is reachable by trusted clients alone. If it is
# not, remove that path from OPENTMF_SECURITY_WHITELIST and give the workers tokens.

# =============================================================================
# 6. Web UI single sign-on
# =============================================================================
# The client registration id is `oidc` — deliberately not a provider name, because
# it is visible to users in /oauth2/authorization/{id}.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_CLIENT_ID=${ENTRA_CLIENT_ID}
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_CLIENT_SECRET=${ENTRA_CLIENT_SECRET}
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_SCOPE=openid,profile,email

SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_OIDC_AUTHORIZATION_URI=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/oauth2/v2.0/authorize
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_OIDC_TOKEN_URI=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/oauth2/v2.0/token
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_OIDC_JWK_SET_URI=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/discovery/v2.0/keys
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_OIDC_USER_INFO_URI=https://graph.microsoft.com/oidc/userinfo
# The signed-in user's identity comes from the `email` claim of the Graph userinfo
# response above. Graph returns it only for accounts that have a mail address, so an
# account without one CANNOT SIGN IN — the callback fails with
# `Attribute value for 'email' cannot be null`. Guests and `#EXT#` accounts are the
# usual case. The identity plugin's fallback-to-upn-when-mail-empty does not help:
# it applies to the directory lookup, which happens after this step. Give such
# accounts an Email in Entra (no mailbox needed), or set this to preferred_username
# and accept UPN-shaped engine user ids.
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_OIDC_USER_NAME_ATTRIBUTE=email

# The BROWSER-facing authorization host. Historically named after Keycloak; it is
# simply the host for whichever provider is configured. It is ALSO what the web
# UI's content-security-policy allows the browser to contact — leave it wrong and
# the sign-in redirect is blocked in the browser with nothing in the server log.
KEYCLOAK_URL_AUTH=https://login.microsoftonline.com

# =============================================================================
# 7. Running behind an Ingress
# =============================================================================
# Without this the service builds redirect URLs from its internal address, and
# Entra rejects them as unregistered reply URLs.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# =============================================================================
# 8. Optional tuning
# =============================================================================
# History retention. Finished instances are stamped with a removal time and a
# nightly job deletes what has expired; without it the history tables grow forever.
# The shipped default is 30 days — set per process definition where that is wrong.
# CADENZAFLOW_BPM_HISTORY_LEVEL=full
#
# Split interactive traffic from background jobs by running two Deployments of this
# same image against the same database: API pods with job execution off, job pods
# with the web UIs off. At least one pod MUST run the job executor.
# CADENZAFLOW_BPM_JOB_EXECUTION_ENABLED=true
# CADENZAFLOW_BPM_WEBAPP_ENABLED=true
